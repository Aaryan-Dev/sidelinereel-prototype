# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=4000
# Local Postgres from docker-compose.yml. In production use the Neon pooled connection string.
DATABASE_URL=postgresql://sidelinereel:sidelinereel@localhost:5433/sidelinereel
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL=postgresql://sidelinereel:sidelinereel@localhost:5433/sidelinereel
# Comma-separated list of allowed browser origins. Not needed when Firebase Hosting proxies /api (same origin).
CORS_ORIGIN=http://localhost:5173
